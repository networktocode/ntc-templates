Value INTERFACE (\S+)
Value ADMIN_STATUS (\S+)
Value OPERATIONAL_STATUS (\S+)
Value POWER (\d+(\.\d+)?)
Value DEVICE (\S+(\s\S+)*)
Value CLASS (\d|n/a)
Value MAX (\d+\.\d+)

Start
  ^Interface\s+Admin\s+Oper\s+Power\s+Device\s+Class\s+Max\s*$$ -> Interfaces
  ^Interface\s+Admin\s+Oper\s+Power\(Watts\)\s+Device\s+Class\s*$$ -> Interfaces45xx
  ^Interface\s+Admin\s+(Priority\s+)?Oper\s+Power\(Watts\)\s+Device\s+Class\s+Police\s+Act(ual)?Consumption\s*$$ -> Interfaces6xxx
  ^PowerSupply\s+SlotNum\.\s+Maximum\s+Allocated\s+Status$$ -> ISR
  ^Available:
  ^Module
  ^\d+
  ^---+
  ^\s+\(Watts\)
  ^\s*$$
  ^%No\s+inline\s+power\s+card\s+on\s+switch\s*$$
  ^. -> Error

Interfaces
  ^Totals:
  ^\s*${INTERFACE}\s+${ADMIN_STATUS}\s+${OPERATIONAL_STATUS}\s+${POWER}\s+${DEVICE}\s+${CLASS}\s+${MAX}\s*$$ -> Record
  ^\s*${INTERFACE}\s+${ADMIN_STATUS}\s+${OPERATIONAL_STATUS}\s+${POWER}\s*$$ -> Record
  ^\s+\(Watts\)
  ^---+
  ^\s*$$ -> Start
  ^. -> Error

Interfaces45xx
  ^\s*${INTERFACE}\s+${ADMIN_STATUS}\s+${OPERATIONAL_STATUS}\s+\d+\.\d+\s+${POWER}\s+${DEVICE}\s+${CLASS}\s*$$ -> Record
  ^\s+From\s+PS\s+To\s+Device\s*$$
  ^---+
  ^\s*$$
  ^Totals:
  ^. -> Error

Interfaces6xxx
  ^\s+\(enabled\s*\)\s+From\s+PS\s+To\s+PD\s*$$
  ^\s+From\s+PS\s+To\s+Device\s*$$
  ^---+
  ^\s*${INTERFACE}\s+${ADMIN_STATUS}(\s+\S+)?\s+${OPERATIONAL_STATUS}\s+\d+(\.\d+)?\s+${POWER}\s+${DEVICE}\s+${CLASS}\s+\S+\s+\S+\s*$$ -> Record
  ^Totals:
  ^. -> Error

ISR
  ^INT-PS
  ^Interface\s+Config\s+Device\s+Powered\s+PowerAllocated$$
  ^---+
  ^${INTERFACE}\s+${ADMIN_STATUS}\s+${DEVICE}\s+${OPERATIONAL_STATUS}\s+${POWER}\s+Watts\s*$$ -> Record
  ^Ethernet\s+Switch
  ^\s+properly\s+upon
  ^. -> Error
