Value TYPE (\w+\s?\w+)
#Value LOCATION (\S*\d+(/\d+)*)
Value LOCATION (\S+)
Value PRODUCT_NUMBER (\S+)
Value DESCRIPTION (.+?)
Value SERIAL (\S+)
Value HARDWARE_VERSION (\S+)

Start
  ^\s*$$
  ^Type\s+Location
  ^\s+Number
  ^---+
  ^${TYPE}\s+${LOCATION}\s+${PRODUCT_NUMBER}\s+${DESCRIPTION}\s+${SERIAL}\s+${HARDWARE_VERSION}\s*$$ -> Record
  ^. -> Error "LINE NOT FOUND"
